{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$sala": {
        ".read": "auth != null",
        "ciclistas": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nombre', 't'])",
            "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "vatios": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000" },
            "velocidad": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
            "cadencia": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250" },
            "distancia": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$otro": { ".validate": false }
          }
        }
      }
    }
  }
}
