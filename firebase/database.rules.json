{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$sala": {
        ".read": "auth != null && auth.provider !== 'anonymous'",
        "ciclistas": {
          "$uid": {
            ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nombre', 't'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "nivel": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
            },
            "vatios": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000"
            },
            "velocidad": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150"
            },
            "cadencia": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250"
            },
            "distancia": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "juntos": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "exige": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "avatares": {
          "$uid": {
            ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.hasChildren(['maillot', 'franja', 'culotte', 'casco', 'bici', 'piel'])",
            "maillot": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "franja": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "culotte": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "casco": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "bici": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "piel": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "bici2": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "modelo": {
              ".validate": "newData.val() === 'ruta' || newData.val() === 'aero' || newData.val() === 'escaladora' || newData.val() === 'cabra'"
            },
            "ruedas": {
              ".validate": "newData.val() === 'bajo' || newData.val() === 'medio' || newData.val() === 'alto' || newData.val() === 'lenticular'"
            },
            "sexo": {
              ".validate": "newData.val() === 'hombre' || newData.val() === 'mujer'"
            },
            "pelo": {
              ".validate": "newData.val() === 'calvo' || newData.val() === 'rapado' || newData.val() === 'corto' || newData.val() === 'largo' || newData.val() === 'monos'"
            },
            "colorPelo": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)"
            },
            "barba": {
              ".validate": "newData.isBoolean()"
            },
            "cascoModelo": {
              ".validate": "newData.val() === 'ruta' || newData.val() === 'aero' || newData.val() === 'clasico' || newData.val() === 'gorra'"
            },
            "marca": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "chat": {
          "$id": {
            ".write": "auth != null && auth.provider !== 'anonymous' && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || data.child('t').val() < now - 86400000)))",
            ".validate": "newData.hasChildren(['uid', 'nombre', 'texto', 't'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "texto": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "audio": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:audio/') && newData.val().length <= 200000"
            },
            "dur": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "$otro": {
              ".validate": false
            }
          }
        },
        "grupetas": {
          ".write": "auth != null && auth.provider !== 'anonymous'",
          ".validate": "newData.hasChildren(['t0', 'autor', 'lista'])",
          "t0": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "autor": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "lista": {
            "$i": {
              ".validate": "newData.hasChildren(['vatios', 's0'])",
              "vatios": {
                ".validate": "newData.isNumber() && newData.val() >= 50 && newData.val() <= 1000"
              },
              "s0": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "$otro": {
                ".validate": false
              }
            }
          },
          "$otro": {
            ".validate": false
          }
        },
        "emojis": {
          "$uid": {
            ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.hasChildren(['e', 't'])",
            "e": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      }
    },
    "programadas": {
      ".read": "auth != null && auth.provider !== 'anonymous'",
      "$id": {
        ".write": "auth != null && auth.provider !== 'anonymous' && ((!data.exists() && newData.child('autorUid').val() === auth.uid) || (data.exists() && data.child('autorUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('hora').val() < now - 86400000))",
        ".validate": "newData.hasChildren(['autorUid', 'autor', 'titulo', 'circuito', 'hora'])",
        "autorUid": {
          ".validate": "newData.isString()"
        },
        "autor": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "titulo": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "circuito": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "hora": {
          ".validate": "newData.isNumber() && newData.val() < now + 5184000000"
        },
        "apuntados": {
          "$uid": {
            ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "compartidos": {
      ".read": "auth != null && auth.provider !== 'anonymous'",
      "$clave": {
        ".write": "auth != null && auth.provider !== 'anonymous' && ((!data.exists() && newData.child('autorUid').val() === auth.uid) || (data.exists() && data.child('autorUid').val() === auth.uid && (!newData.exists() || newData.child('autorUid').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['autorUid', 'autor', 't', 'entreno']) && $clave.beginsWith(auth.uid + '_')",
        "autorUid": {
          ".validate": "newData.isString()"
        },
        "autor": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "entreno": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20000"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "records": {
      ".read": "auth != null && auth.provider !== 'anonymous'",
      "$circuito": {
        "$segmento": {
          "$uid": {
            ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nombre', 'ms', 't'])",
            "nombre": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "ms": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 36000000"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$otro": {
              ".validate": false
            }
          }
        }
      }
    },
    "totales": {
      ".read": "auth != null && auth.provider !== 'anonymous'",
      "$uid": {
        ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nombre', 'sesiones', 'segundos', 'metros', 'desnivel', 't'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "sesiones": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
        },
        "segundos": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
        },
        "metros": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
        },
        "desnivel": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 10000000"
        },
        "rueda": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        "perfil": {
          ".read": "auth != null && auth.provider !== 'anonymous' && (auth.uid === '1WbWzGi0H6fmFUTyMspm5UGL3pU2' || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['avatar', 'pesoKg', 'ftp'])"
        },
        "propios": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'nombre', 'bloques'])"
          }
        },
        "historial": {
          "$id": {
            ".validate": "newData.hasChildren(['id', 'inicio', 'resumen'])"
          }
        },
        "muestras": {
          "$id": {
            ".validate": "newData.isString() && newData.val().length < 3000000"
          }
        },
        "borrados": {
          "$id": {
            ".validate": "newData.isNumber()"
          }
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        ".write": false
      }
    },
    "fichas": {
      ".read": "auth != null && auth.provider !== 'anonymous' && (auth.uid === '1WbWzGi0H6fmFUTyMspm5UGL3pU2' || root.child('admins').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        ".write": "auth != null && auth.provider !== 'anonymous' && auth.uid === $uid",
        ".validate": "newData.hasChildren(['nombre', 'correo', 'sesiones', 'metros', 'strava', 'alta', 't'])",
        "nombre": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "correo": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "sesiones": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
        },
        "metros": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
        },
        "strava": {
          ".validate": "newData.isBoolean()"
        },
        "alta": {
          ".validate": "newData.isNumber()"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "stravaAtleta": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
