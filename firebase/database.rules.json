{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$sala": {
        ".read": "auth != null",
        "ciclistas": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['nombre', 't'])",
            "nombre": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "vatios": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3000" },
            "velocidad": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 150" },
            "cadencia": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 250" },
            "distancia": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
            "t": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$otro": { ".validate": false }
          }
        },
        "avatares": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['maillot', 'franja', 'culotte', 'casco', 'bici', 'piel'])",
            "maillot": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "franja": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "culotte": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "casco": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "bici": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "piel": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "bici2": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]$/)" },
            "modelo": { ".validate": "newData.val() === 'ruta' || newData.val() === 'aero' || newData.val() === 'escaladora' || newData.val() === 'cabra'" },
            "ruedas": { ".validate": "newData.val() === 'bajo' || newData.val() === 'medio' || newData.val() === 'alto' || newData.val() === 'lenticular'" },
            "$otro": { ".validate": false }
          }
        }
      }
    }
  }
}
